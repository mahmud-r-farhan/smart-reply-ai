# Base path of the Smart Reply backend API.
# Default "/api" is proxied to http://localhost:5006 by the Vite dev server.
# In production point it at your deployed backend, e.g. https://api.example.com/api
VITE_API_ENDPOINT=/api

# Optional: override the dev-server proxy target
# VITE_BACKEND_ORIGIN=http://localhost:5006
