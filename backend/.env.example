# ------------------------------------------------------------------
# Smart Reply AI — Backend configuration
# Copy to `.env` and adjust. Every value is optional: without an API key
# the backend automatically serves the zero-latency heuristic engine.
# ------------------------------------------------------------------

# ---- HTTP server -------------------------------------------------
PORT=5006
NODE_ENV=development

# Number of trusted reverse-proxy hops in front of the service.
# Set to 1 behind Nginx/Cloudflare/ALB so rate limiting sees real client IPs.
# Leave unset when the service is exposed directly to the internet.
# TRUST_PROXY=1

# Comma separated list of allowed browser origins (default: *).
# CORS_ORIGINS=https://smart-reply-web.vercel.app,http://localhost:5173
# CORS_ORIGIN (singular) is accepted as a legacy alias for a single origin.

# Per-IP rate limiting for /api routes
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=60

# Maximum accepted JSON body size
JSON_BODY_LIMIT=64kb

# ---- LLM provider -------------------------------------------------
# Any OpenAI-compatible provider works (OpenRouter, Groq, OpenAI, Ollama).
OPENROUTER_API_KEY=your_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1

# Alternatively (takes precedence over OPENROUTER_API_KEY):
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.1-8b-instant

# Request timeouts (ms) and retry count (0-3)
LLM_TIMEOUT_MS=12000
LLM_LOCAL_TIMEOUT_MS=25000
LLM_RETRIES=1

# --- SSRF protection -------------------------------------------------
# By default the backend only forwards requests to known provider origins
# (OpenRouter, Groq, OpenAI, local Ollama on port 11434). Custom endpoints
# supplied by clients are rejected, and the server-side API key is NEVER
# attached to a non-allowlisted endpoint.
# Set to true only if you understand the risk (e.g. self-hosted gateway).
ALLOW_CUSTOM_LLM_ENDPOINT=false

# Extra allowlisted provider origins, comma separated:
# LLM_ALLOWED_HOSTS=https://gateway.internal:8443,https://llm.my-company.com

# ---- Cache ---------------------------------------------------------
CACHE_TTL_MS=600000
CACHE_MAX_ENTRIES=5000

# Optional shared Redis tier so scaled replicas share warm results.
# Leave empty to use the per-worker in-memory LRU cache only.
# REDIS_URL=redis://cache:6379

# ---- Cluster -------------------------------------------------------
# Worker processes spawned by `npm run start:cluster` (default: CPU count, max 8)
WORKERS=2
